// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Profesor {
  id       String  @id @default(uuid())
  nombre   String
  apellido String
  email    String  @unique
  googleId String  @unique
  cursos   Curso[]
}

model Curso {
  id          String        @id @default(uuid())
  materia     String
  anio        Int
  division    String
  anioLectivo Int
  profesorId  String
  profesor    Profesor      @relation(fields: [profesorId], references: [id])
  alumnos     AlumnoCurso[]
  examenes    Examen[]
}

model Alumno {
  id       String        @id @default(uuid())
  nombre   String
  apellido String
  legajo   String        @unique
  cursos   AlumnoCurso[]
  entregas Entrega[]
}

model AlumnoCurso {
  alumnoId String @map("idAlumno")
  cursoId  String @map("idCurso")
  alumno   Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  curso    Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([alumnoId, cursoId])
  @@map("_AlumnoToCurso")
}

model Examen {
  id        String     @id @default(uuid())
  titulo    String
  fecha     DateTime   @default(now())
  cursoId   String
  curso     Curso      @relation(fields: [cursoId], references: [id])
  preguntas Pregunta[]
  entregas  Entrega[]
}

model Pregunta {
  id                 String  @id @default(uuid())
  examenId           String
  examen             Examen  @relation(fields: [examenId], references: [id])
  enunciado          String
  respuestaEsperada  String
  puntajeMaximo      Float
  criteriosIA        String?
  esEvaluacionVisual Boolean @default(false)
}

model Entrega {
  id         String      @id @default(uuid())
  examenId   String
  examen     Examen      @relation(fields: [examenId], references: [id])
  alumnoId   String
  alumno     Alumno      @relation(fields: [alumnoId], references: [id])
  archivo    String
  estado     String      // "PENDIENTE", "PROCESANDO", "REQUIERE_REVISION", "PENDIENTE_APROBACION", "PUBLICADO"
  correccion Correccion?
}

model Correccion {
  id              String    @id @default(uuid())
  entregaId       String    @unique
  entrega         Entrega   @relation(fields: [entregaId], references: [id])
  notaIA          Float?
  notaFinal       Float?
  nivelConfianza  String?   // "BAJO", "MEDIO", "ALTO"
  feedbackJSON    String?
  fechaAprobacion DateTime?
}
