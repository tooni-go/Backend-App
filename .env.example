# ==============================================================================
# 🗄️ BASE DE DATOS Y SERVIDOR
# ==============================================================================
# URL de conexión para Prisma ORM (SQLite en desarrollo local, PostgreSQL en prod)
DATABASE_URL=file:./dev.db

# Puerto en el que escucha la API de NestJS
PORT=3001

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ==============================================================================
# 🔐 AUTENTICACIÓN Y SEGURIDAD
# ==============================================================================
# Clave secreta para firmar y validar tokens JWT de sesión (generar una segura en producción)
JWT_SECRET=super-secret-key-evalia

# Client ID de Google OAuth 2.0 para autenticar profesores
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# ==============================================================================
# 📁 ALMACENAMIENTO DE ARCHIVOS
# ==============================================================================
# Directorio donde se guardan las entregas y documentos subidos
UPLOADS_DIR=uploads

# Tamaño máximo permitido por archivo subido (en Megabytes)
MAX_UPLOAD_SIZE_MB=10

# ==============================================================================
# 🤖 MOTORES DE INTELIGENCIA ARTIFICIAL (GEMINI + OPENROUTER)
# ==============================================================================
# API Key de Google Gemini (generación y corrección asistida)
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.1-flash-lite

# API Key de OpenRouter (mecanismo de contingencia / fallback automático)
OPENROUTER_API_KEY=tu_api_key_de_openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini

# Tiempo de espera límite en milisegundos para llamadas a IA
AI_TIMEOUT_MS=15000
