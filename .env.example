# Database Connection URL (Defaults to local SQLite if not specified)
DATABASE_URL=file:./dev.db

# Server Port
PORT=3000

# Directory for file uploads (Default: uploads in project root)
UPLOADS_DIR=uploads

# Maximum upload size in Megabytes (Default: 10)
MAX_UPLOAD_SIZE_MB=10

# Google Gemini API Key and Model for Exam Evaluation and Generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenRouter API Key (Optional Fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

